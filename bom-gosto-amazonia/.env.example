# Uso local: copie este arquivo para ".env". Em hospedagem (Render etc.), cadastre estas variáveis no painel do serviço.
PORT=3000
NODE_ENV=production
# Pasta do banco de dados e dos arquivos enviados. Em hospedagem, aponte para o DISCO PERMANENTE (ex.: /data).
DATA_DIR=./data
# Código secreto para criar o PRIMEIRO administrador (tela "Primeiro acesso"). Só é pedido enquanto não existe nenhum usuário.
SETUP_CODE=escolha-um-codigo-secreto
# Fuso horário da empresa (define o que é "hoje" para calcular atrasos). Manaus = America/Manaus, Belém = America/Belem
TZ=America/Manaus
# Limite de tamanho por arquivo enviado (MB)
MAX_UPLOAD_MB=30

# ---- Backup automático e criptografado no GitHub (necessário em hospedagem grátis com disco temporário; opcional como cópia extra) ----
# Repositório PRIVADO só para os backups (crie com "Add a README file") e um token com permissão "Contents: Read and write" nele.
BACKUP_GITHUB_REPO=
BACKUP_GITHUB_TOKEN=
# Senha que criptografa o backup (mínimo 12 caracteres). Sem ela não dá para restaurar — guarde uma cópia.
BACKUP_KEY=
# Recuperar acesso sem terminal: defina as duas, reinicie, entre com a senha provisória e APAGUE as variáveis.
# REDEFINIR_SENHA_EMAIL=
# REDEFINIR_SENHA_NOVA=
