# Copie para .env (uso local) ou configure estas variáveis no seu serviço de hospedagem.
PORT=3000
NODE_ENV=production
# Pasta onde ficam o banco de dados e os arquivos enviados. Em hospedagem, aponte para o DISCO PERSISTENTE (ex.: /data)
DATA_DIR=./data
# Chave para assinar cookies. Gere um texto longo e aleatório.
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
# Código para criar o PRIMEIRO administrador (tela "Primeiro acesso"). Só é usado quando o sistema ainda não tem usuários.
SETUP_CODE=escolha-um-codigo-secreto
# Fuso horário da empresa (define o que é "hoje" para atrasos). Manaus = America/Manaus, Belém = America/Belem
TZ=America/Manaus
