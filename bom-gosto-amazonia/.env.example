# Uso local: copie este arquivo para ".env". Em hospedagem (Render etc.), cadastre estas variáveis no painel do serviço.
PORT=3000
NODE_ENV=production
# Pasta do banco de dados e dos arquivos enviados. Em hospedagem, aponte para o DISCO PERMANENTE (ex.: /data).
DATA_DIR=./data
# Código secreto para criar o PRIMEIRO administrador (tela "Primeiro acesso"). Só é pedido enquanto não existe nenhum usuário.
SETUP_CODE=escolha-um-codigo-secreto
# Fuso horário da empresa (define o que é "hoje" para calcular atrasos). Manaus = America/Manaus, Belém = America/Belem
TZ=America/Manaus
# Limite de tamanho por arquivo enviado (MB)
MAX_UPLOAD_MB=30
